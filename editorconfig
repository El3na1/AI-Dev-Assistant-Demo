# top-most EditorConfig file
root = true

[*.cs]

# Indentation style
indent_style = tab

# Qualify member access
dotnet_style_qualification_for_field = true:error
dotnet_style_qualification_for_property = true:error
dotnet_style_qualification_for_method = true:error

# Explicit typing preferences
csharp_style_var_elsewhere = false:error
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:warning

# Analyzer severity levels
dotnet_diagnostic.IDE0044.severity = error
dotnet_diagnostic.IDE0051.severity = warning

#########################################################
# Naming Styles and Rules
#########################################################

# Capitalization styles
dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_style.camel_case_style.capitalization = camel_case

# Symbol Groups
dotnet_naming_symbols.namespaces.applicable_kinds = namespace
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.methods.applicable_kinds = method
dotnet_naming_symbols.properties.applicable_kinds = property
dotnet_naming_symbols.events.applicable_kinds = event
dotnet_naming_symbols.fields.applicable_kinds = field
dotnet_naming_symbols.enums.applicable_kinds = enum
dotnet_naming_symbols.enum_members.applicable_kinds = enum_member
dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_symbols.locals.applicable_kinds = local

# Naming Rules
dotnet_naming_rule.namespace_should_be_pascal_case.symbols = namespaces
dotnet_naming_rule.namespace_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.namespace_should_be_pascal_case.severity = error

dotnet_naming_rule.type_should_be_pascal_case.symbols = types
dotnet_naming_rule.type_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.type_should_be_pascal_case.severity = error

dotnet_naming_rule.interface_should_be_pascal_case.symbols = interfaces
dotnet_naming_rule.interface_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.interface_should_be_pascal_case.severity = error

dotnet_naming_rule.method_should_be_pascal_case.symbols = methods
dotnet_naming_rule.method_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.method_should_be_pascal_case.severity = error

dotnet_naming_rule.property_should_be_pascal_case.symbols = properties
dotnet_naming_rule.property_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.property_should_be_pascal_case.severity = error

dotnet_naming_rule.event_should_be_pascal_case.symbols = events
dotnet_naming_rule.event_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.event_should_be_pascal_case.severity = error

dotnet_naming_rule.field_should_be_pascal_case.symbols = fields
dotnet_naming_rule.field_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.field_should_be_pascal_case.severity = error

dotnet_naming_rule.enum_should_be_pascal_case.symbols = enums
dotnet_naming_rule.enum_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.enum_should_be_pascal_case.severity = error

dotnet_naming_rule.enum_member_should_be_pascal_case.symbols = enum_members
dotnet_naming_rule.enum_member_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.enum_member_should_be_pascal_case.severity = error

dotnet_naming_rule.parameter_should_be_camel_case.symbols = parameters
dotnet_naming_rule.parameter_should_be_camel_case.style = camel_case_style
dotnet_naming_rule.parameter_should_be_camel_case.severity = error

dotnet_naming_rule.local_should_be_camel_case.symbols = locals
dotnet_naming_rule.local_should_be_camel_case.style = camel_case_style
dotnet_naming_rule.local_should_be_camel_case.severity = error